TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres connection string (Neon / Vercel Postgres / Supabase; use the pooled endpoint).
# Leave empty in development to use the embedded PGlite database.
DATABASE_URL=

# The /admin panel stays disabled until this is set.
ADMIN_PASSWORD=

# Optional: separate signing secret for the admin session cookie (defaults to ADMIN_PASSWORD).
ADMIN_SECRET=

# Public origin used for canonical URLs, Open Graph and the sitemap.
# On Vercel it is derived automatically from VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
